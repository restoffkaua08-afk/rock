# Rock V0.1 provider credentials
# Leave a key empty to disable that online provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Model overrides. Keep provider/model format required by LiteLLM.
ROCK_OPENAI_MODEL=openai/gpt-5.6-terra
ROCK_ANTHROPIC_MODEL=anthropic/claude-sonnet-5
ROCK_DEEPSEEK_MODEL=deepseek-chat
ROCK_PERPLEXITY_MODEL=perplexity/sonar
ROCK_GEMINI_MODEL=gemini/gemini-2.5-flash
ROCK_OLLAMA_MODEL=ollama/llama3.2:3b

# Superpowers checkout (setup can populate this automatically)
ROCK_SUPERPOWERS_PATH=

# Council selection
ROCK_COUNCIL_PROTOCOL=parallel
ROCK_COUNCIL_ROUNDS=1
ROCK_COUNCIL_CRITIC_MODEL=
ROCK_COUNCIL_SYNTHESIZER_MODEL=
ROCK_COUNCIL_VERIFIER_MODEL=
ROCK_COUNCIL_JUDGE_MODEL=
ROCK_COUNCIL_RED_TEAM_MODEL=
ROCK_COUNCIL_VOTER_MODEL=
# Optional comma-separated providers. Leave empty to use all configured providers.
ROCK_COUNCIL_MODELS=

# Runtime
# Keep mock for a first installation. Change to live after configuring a provider.
ROCK_MODE=mock
ROCK_DB_PATH=.rock/sessions.db
ROCK_MAX_RETRIES=2
ROCK_TIMEOUT_SECONDS=120
ROCK_MAX_PARALLEL=5
ROCK_MAX_COST=
