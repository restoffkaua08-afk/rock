# Provider credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Optional model overrides
ROCK_OPENAI_MODEL=
ROCK_ANTHROPIC_MODEL=
ROCK_DEEPSEEK_MODEL=
ROCK_PERPLEXITY_MODEL=
ROCK_GEMINI_MODEL=
ROCK_OLLAMA_MODEL=

# Runtime
ROCK_MODE=mock
ROCK_DB_PATH=.rock/sessions.db
ROCK_MAX_RETRIES=2
ROCK_TIMEOUT_SECONDS=60
ROCK_MAX_PARALLEL=5
